<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="KeyAutomator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KeyAutomator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="KeyAutomator"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="KeyAutomator"
            Subtitle="キー入力マクロ">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1" Padding="20,8,20,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Macros" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="登録済みのキー入力シーケンス" />
                    </StackPanel>

                    <ListView
                        x:Name="MacroList"
                        Grid.Row="1"
                        AutomationProperties.Name="マクロ一覧"
                        ItemsSource="{Binding Macros}"
                        SelectedItem="{Binding SelectedMacro, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        MinWidth="36"
                                        Padding="8,4"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Text="{Binding Id}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding DelaySec}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Button
                            AccessKey="N"
                            AutomationProperties.Name="新規作成"
                            Click="NewButton_Click"
                            Content="新規"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            AutomationProperties.Name="複製"
                            Click="CloneButton_Click"
                            Content="複製"
                            IsEnabled="{Binding HasSelection}" />
                        <Button
                            AutomationProperties.Name="削除"
                            Click="DeleteButton_Click"
                            Content="削除"
                            IsEnabled="{Binding HasSelection}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{Binding HasSelection}" VerticalContentAlignment="Stretch">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Editor" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="基本情報とアクションを編集" />
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="ID" />
                            <NumberBox
                                AutomationProperties.Name="マクロID"
                                Minimum="1"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding EditId, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="マクロ名" />
                            <TextBox
                                AutomationProperties.Name="マクロ名"
                                PlaceholderText="例: ログイン処理"
                                Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="起動前ウェイト (秒)" />
                            <NumberBox
                                AutomationProperties.Name="起動前ウェイト秒"
                                Minimum="0"
                                SmallChange="0.5"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding EditDelaySec, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.Name="テキスト追加" Click="AddText_Click" Content="+ テキスト" />
                        <Button AutomationProperties.Name="特殊キー追加" Click="AddKey_Click" Content="+ 特殊キー" />
                        <Button AutomationProperties.Name="ショートカット追加" Click="AddHotkey_Click" Content="+ ショートカット" />
                        <Button AutomationProperties.Name="ウェイト追加" Click="AddWait_Click" Content="+ ウェイト" />
                        <Border
                            Width="1"
                            Margin="4,4"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button AutomationProperties.Name="上へ" Click="MoveUp_Click" Content="▲" />
                        <Button AutomationProperties.Name="下へ" Click="MoveDown_Click" Content="▼" />
                        <Button AutomationProperties.Name="アクション削除" Click="RemoveAction_Click" Content="削除" />
                    </StackPanel>

                    <ListView
                        Grid.Row="3"
                        AutomationProperties.Name="アクション一覧"
                        ItemsSource="{Binding Actions}"
                        SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.Header>
                            <Grid Padding="12,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="種別" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="設定値" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        MinWidth="120"
                                        AutomationProperties.Name="アクション種別"
                                        SelectedItem="{Binding Type, Mode=TwoWay}">
                                        <x:String>text</x:String>
                                        <x:String>key</x:String>
                                        <x:String>hotkey</x:String>
                                        <x:String>wait</x:String>
                                    </ComboBox>
                                    <TextBox
                                        Grid.Column="1"
                                        AutomationProperties.Name="アクション設定値"
                                        PlaceholderText="値を入力"
                                        Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                        <Button
                            AccessKey="S"
                            AutomationProperties.Name="保存"
                            Click="SaveButton_Click"
                            Content="保存"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            AutomationProperties.Name="キャンセル"
                            Click="CancelButton_Click"
                            Content="編集を破棄" />
                        <Button
                            x:Name="TestButton"
                            AutomationProperties.Name="テスト実行"
                            Click="TestButton_Click"
                            Content="テスト実行" />
                    </StackPanel>
                </Grid>
                </ContentControl>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="20,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding StatusMessage}" />
                <TextBlock
                    x:Name="VersionText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="v2.0.0" />
            </Grid>
        </Border>

        <ContentDialog
            x:Name="HotkeyDialog"
            Title="ショートカットを記録"
            CloseButtonText="キャンセル"
            DefaultButton="Primary"
            PrimaryButtonClick="HotkeyDialog_PrimaryButtonClick"
            PrimaryButtonText="追加">
            <StackPanel Spacing="12">
                <TextBlock
                    Text="キーボードで組み合わせを押してください（例: Ctrl+Shift+S）"
                    TextWrapping="WrapWholeWords" />
                <Border
                    Padding="16"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8"
                    IsTabStop="True"
                    KeyDown="HotkeyCaptureArea_KeyDown">
                    <TextBlock
                        x:Name="HotkeyResultText"
                        FontFamily="Consolas"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="キーを押してください…" />
                </Border>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
