<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="KeyAutomator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:KeyAutomator.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KeyAutomator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="KeyAutomator"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True" />
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
            <Style x:Key="InlineLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CompactActionItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="SlimButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="AppTitleBar"
            Title="KeyAutomator">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1" Padding="20,8,20,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左: マクロ一覧 -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="MacroListHeading" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock
                            x:Uid="MacroListHint"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ListView
                        x:Name="MacroList"
                        x:Uid="MacroList"
                        Grid.Row="1"
                        AllowDrop="True"
                        AutomationProperties.AutomationId="MacroListView"
                        CanDragItems="True"
                        CanReorderItems="True"
                        DragItemsCompleted="MacroList_DragItemsCompleted"
                        ItemsSource="{Binding Macros}"
                        SelectionChanged="MacroList_SelectionChanged"
                        SelectionMode="Extended"
                        IsEnabled="{Binding IsIdle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Text="{Binding Id}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding DelayLabel}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{Binding ActionCountLabel}" />
                                        <TextBlock
                                            FontSize="12"
                                            FontFamily="Consolas"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding AliasLabel}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Uid="NewMacroButton"
                            AccessKey="N"
                            AutomationProperties.AutomationId="NewMacroButton"
                            Click="NewButton_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Uid="LoadSampleButton"
                            Click="LoadSampleButton_Click" />
                        <Button
                            x:Uid="CloneButton"
                            Click="CloneButton_Click"
                            IsEnabled="{Binding HasSelection}" />
                        <Button
                            x:Uid="DeleteMacroButton"
                            Click="DeleteButton_Click"
                            IsEnabled="{Binding HasSelection}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右: 編集 -->
            <Border
                Grid.Column="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <!-- 未選択時 -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisInvert}}">
                        <FontIcon
                            FontSize="40"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8A5;" />
                        <TextBlock
                            x:Uid="EmptyTitle"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Uid="EmptyHint"
                            HorizontalAlignment="Center"
                            TextWrapping="WrapWholeWords"
                            MaxWidth="360"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Uid="EmptyNewButton"
                                Click="NewButton_Click"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Uid="EmptyLoadSampleButton"
                                Click="LoadSampleButton_Click" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="EmptyTestHint"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <!-- 編集本体 -->
                    <ContentControl
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- タイトル + 基本情報（1枠） -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    x:Uid="EditHeading"
                                    VerticalAlignment="Top"
                                    Margin="0,8,0,0"
                                    FontSize="18"
                                    FontWeight="SemiBold" />

                                <Border
                                    Grid.Column="1"
                                    Padding="12,10"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 1行目: ID / 名前 -->
                                        <TextBlock x:Uid="LabelId" Style="{StaticResource InlineLabelStyle}" />
                                        <NumberBox
                                            x:Uid="EditIdBox"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{Binding EditId, Mode=TwoWay}" />

                                        <TextBlock
                                            x:Uid="LabelName"
                                            Grid.Column="2"
                                            Style="{StaticResource InlineLabelStyle}" />
                                        <TextBox
                                            x:Uid="EditNameBox"
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="MacroNameBox"
                                            Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- 2行目: 開始まで / 引数名 -->
                                        <TextBlock
                                            x:Uid="LabelDelay"
                                            Grid.Row="1"
                                            Style="{StaticResource InlineLabelStyle}" />
                                        <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox
                                                x:Uid="EditDelayBox"
                                                VerticalAlignment="Center"
                                                Minimum="0"
                                                SmallChange="0.5"
                                                SpinButtonPlacementMode="Compact"
                                                Value="{Binding EditDelaySec, Mode=TwoWay}" />
                                            <TextBlock
                                                x:Uid="SecondsLabel"
                                                Grid.Column="1"
                                                Style="{StaticResource InlineLabelStyle}"
                                                Margin="0" />
                                        </Grid>

                                        <TextBlock
                                            x:Uid="LabelAlias"
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Style="{StaticResource InlineLabelStyle}" />
                                        <TextBox
                                            x:Uid="EditAliasBox"
                                            Grid.Row="1"
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            Text="{Binding EditAlias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 実行手順: ツールバー -->
                            <Grid Grid.Row="1">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Uid="ActionsHeading"
                                        Style="{StaticResource SectionTitleStyle}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ActionSummary}" />
                                </StackPanel>
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button
                                        x:Uid="AddTextButton"
                                        Click="AddText_Click"
                                        Style="{StaticResource SlimButtonStyle}" />
                                    <Button
                                        x:Uid="AddKeyButton"
                                        Click="AddKey_Click"
                                        Style="{StaticResource SlimButtonStyle}" />
                                    <Button
                                        x:Uid="AddHotkeyButton"
                                        Click="AddHotkey_Click"
                                        Style="{StaticResource SlimButtonStyle}" />
                                    <Button
                                        x:Uid="AddMouseButton"
                                        Click="AddMouse_Click"
                                        Style="{StaticResource SlimButtonStyle}" />
                                    <Button
                                        x:Uid="AddWaitButton"
                                        AutomationProperties.AutomationId="AddWaitActionButton"
                                        Click="AddWait_Click"
                                        Style="{StaticResource SlimButtonStyle}" />
                                    <Button
                                        x:Uid="AddDialogButton"
                                        AutomationProperties.AutomationId="AddDialogActionButton"
                                        Click="AddDialog_Click"
                                        Style="{StaticResource SlimButtonStyle}" />
                                    <Button
                                        x:Uid="WrapRepeatButton"
                                        AutomationProperties.AutomationId="WrapInRepeatButton"
                                        Click="WrapInRepeat_Click"
                                        Style="{StaticResource SlimButtonStyle}" />
                                    <Border
                                        Width="1"
                                        Margin="4,2"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Button
                                        x:Uid="MoveUpButton"
                                        Click="MoveUp_Click"
                                        Style="{StaticResource SlimButtonStyle}" />
                                    <Button
                                        x:Uid="MoveDownButton"
                                        Click="MoveDown_Click"
                                        Style="{StaticResource SlimButtonStyle}" />
                                    <Button
                                        x:Uid="RemoveActionButton"
                                        Click="RemoveAction_Click"
                                        Style="{StaticResource SlimButtonStyle}" />
                                </StackPanel>
                            </Grid>

                            <!-- 固定カラムヘッダー -->
                            <Border
                                Grid.Row="2"
                                Padding="8,6"
                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="8,8,0,0">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="148" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="#" />
                                    <TextBlock
                                        Grid.Column="1"
                                        x:Uid="ColType"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        x:Uid="ColValue"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Border>

                            <!-- スクロールする手順一覧（ヘッダーは上で固定） -->
                            <Border
                                Grid.Row="3"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,8,8">
                                <ListView
                                    x:Name="ActionList"
                                    x:Uid="ActionList"
                                    Padding="6,4"
                                    AllowDrop="True"
                                    CanDragItems="True"
                                    CanReorderItems="True"
                                    DragItemsCompleted="ActionList_DragItemsCompleted"
                                    IsEnabled="{Binding IsIdle}"
                                    ItemContainerStyle="{StaticResource CompactActionItemStyle}"
                                    ItemsSource="{Binding Actions}"
                                    SelectionChanged="ActionList_SelectionChanged"
                                    SelectionMode="Extended">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                MinHeight="47"
                                                Padding="0"
                                                ColumnSpacing="0"
                                                ToolTipService.ToolTip="{Binding Hint}">
                                                <Border
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="6"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />

                                                <!-- 繰り返しブロックの薄い背景 -->
                                                <Border
                                                    Margin="0,1"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="6"
                                                    Opacity="0.08"
                                                    Visibility="{Binding IsLoopMarker, Converter={StaticResource BoolToVis}}" />

                                                <Grid Padding="4,4,8,4" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="148" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- ネストインデント -->
                                                    <Border
                                                        Width="{Binding IndentWidth}"
                                                        Background="Transparent" />

                                                    <!-- ループ開始/終了のアクセントバー -->
                                                    <Border
                                                        Grid.Column="1"
                                                        Width="3"
                                                        Margin="0,6"
                                                        VerticalAlignment="Stretch"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="1.5"
                                                        Visibility="{Binding IsLoopMarker, Converter={StaticResource BoolToVis}}" />

                                                    <Border
                                                        Grid.Column="2"
                                                        Width="28"
                                                        Height="28"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding Step}" />
                                                    </Border>

                                                    <ComboBox
                                                        x:Uid="ActionTypeBox"
                                                        Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        DisplayMemberPath="Label"
                                                        ItemsSource="{Binding TypeOptions}"
                                                        SelectedItem="{Binding SelectedTypeOption, Mode=TwoWay}" />

                                                    <!-- 特殊キー -->
                                                    <ComboBox
                                                        x:Uid="SpecialKeyBox"
                                                        Grid.Column="4"
                                                        VerticalAlignment="Center"
                                                        DisplayMemberPath="Label"
                                                        IsTextSearchEnabled="True"
                                                        ItemsSource="{Binding SpecialKeyOptions}"
                                                        MaxDropDownHeight="420"
                                                        SelectedItem="{Binding SelectedSpecialKey, Mode=TwoWay}"
                                                        Visibility="{Binding IsKeyType, Converter={StaticResource BoolToVis}}" />

                                                    <!-- マウスクリック -->
                                                    <ComboBox
                                                        x:Uid="MouseActionBox"
                                                        Grid.Column="4"
                                                        VerticalAlignment="Center"
                                                        DisplayMemberPath="Label"
                                                        ItemsSource="{Binding MouseActionOptions}"
                                                        SelectedItem="{Binding SelectedMouseAction, Mode=TwoWay}"
                                                        Visibility="{Binding IsMouseType, Converter={StaticResource BoolToVis}}" />

                                                    <!-- ショートカット: 同時押しキーを複数追加 -->
                                                    <ScrollViewer
                                                        Grid.Column="4"
                                                        HorizontalScrollBarVisibility="Auto"
                                                        HorizontalScrollMode="Enabled"
                                                        VerticalScrollBarVisibility="Disabled"
                                                        VerticalScrollMode="Disabled"
                                                        Visibility="{Binding IsHotkeyType, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <ItemsControl ItemsSource="{Binding HotkeyParts}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                            <ComboBox
                                                                                x:Uid="HotkeyPartBox"
                                                                                MinWidth="100"
                                                                                VerticalAlignment="Center"
                                                                                DisplayMemberPath="Label"
                                                                                IsTextSearchEnabled="True"
                                                                                ItemsSource="{Binding KeyOptions}"
                                                                                MaxDropDownHeight="360"
                                                                                SelectedItem="{Binding SelectedOption, Mode=TwoWay}" />
                                                                            <Button
                                                                                x:Uid="RemoveHotkeyPartButton"
                                                                                Padding="6,2"
                                                                                VerticalAlignment="Center"
                                                                                Command="{Binding RemoveCommand}"
                                                                                FontSize="12" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button
                                                                x:Uid="AddHotkeyPartButton"
                                                                Padding="8,2"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding AddHotkeyPartCommand}"
                                                                FontSize="12" />
                                                        </StackPanel>
                                                    </ScrollViewer>

                                                    <!-- 繰り返し回数 -->
                                                    <StackPanel
                                                        Grid.Column="4"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        Visibility="{Binding IsRepeatType, Converter={StaticResource BoolToVis}}">
                                                        <NumberBox
                                                            x:Uid="RepeatCountBox"
                                                            Width="110"
                                                            Minimum="1"
                                                            Maximum="9999"
                                                            SpinButtonPlacementMode="Compact"
                                                            Value="{Binding RepeatCount, Mode=TwoWay}" />
                                                        <TextBlock
                                                            x:Uid="RepeatTimesLabel"
                                                            VerticalAlignment="Center"
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    </StackPanel>

                                                    <!-- ここまで -->
                                                    <TextBlock
                                                        x:Uid="EndRepeatLabel"
                                                        Grid.Column="4"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Visibility="{Binding IsEndRepeatType, Converter={StaticResource BoolToVis}}" />

                                                    <!-- テキスト / 待機 / 確認 -->
                                                    <TextBox
                                                        x:Uid="ActionValueBox"
                                                        Grid.Column="4"
                                                        VerticalAlignment="Center"
                                                        PlaceholderText="{Binding Placeholder}"
                                                        Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Visibility="{Binding IsFreeTextType, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>

                            <!-- 保存バー -->
                            <StackPanel
                                Grid.Row="4"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Uid="SaveButton"
                                    AccessKey="S"
                                    AutomationProperties.AutomationId="SaveMacroButton"
                                    Click="SaveButton_Click"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    x:Uid="DiscardButton"
                                    Click="CancelButton_Click"
                                    Style="{StaticResource SlimButtonStyle}" />
                                <Button
                                    x:Name="TestButton"
                                    x:Uid="TestButton"
                                    Click="TestButton_Click"
                                    Content="{Binding TestButtonLabel}"
                                    Style="{StaticResource SlimButtonStyle}" />
                                <Border
                                    Width="1"
                                    Margin="4,4"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Button
                                    x:Uid="CopyLaunchInlineButton"
                                    AutomationProperties.AutomationId="CopyCliLaunchPathInlineButton"
                                    Click="CopyCliLaunchPath_Click"
                                    Style="{StaticResource SlimButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="20,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        x:Uid="OpenFolderButton"
                        Click="OpenDataFolder_Click"
                        Style="{StaticResource SlimButtonStyle}" />
                    <Button
                        x:Uid="CopyLaunchPathButton"
                        AutomationProperties.AutomationId="CopyCliLaunchPathButton"
                        Click="CopyCliLaunchPath_Click"
                        Style="{StaticResource SlimButtonStyle}" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding StatusMessage}"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Uid="ActionDelayLabel"
                        VerticalAlignment="Center" />
                    <NumberBox
                        x:Uid="ActionDelayBox"
                        Width="88"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ActionDelaySecBox"
                        Minimum="0"
                        Maximum="10"
                        SmallChange="0.05"
                        LargeChange="0.1"
                        SpinButtonPlacementMode="Compact"
                        Value="{Binding ActionDelaySec, Mode=TwoWay}" />
                    <TextBlock
                        x:Uid="SecondsLabel"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border
                        Width="1"
                        Height="20"
                        Margin="4,0"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock
                        x:Uid="ConfirmDeleteLabel"
                        VerticalAlignment="Center" />
                    <ToggleSwitch
                        x:Uid="ConfirmDeleteSwitch"
                        VerticalAlignment="Center"
                        IsOn="{Binding ConfirmBeforeDelete, Mode=TwoWay}"
                        OffContent="OFF"
                        OnContent="ON" />
                </StackPanel>

                <StackPanel
                    Grid.Column="3"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Uid="LanguageLabel"
                        VerticalAlignment="Center" />
                    <ComboBox
                        x:Name="LanguageBox"
                        x:Uid="LanguageBox"
                        MinWidth="140"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="LanguageBox"
                        SelectionChanged="LanguageBox_SelectionChanged" />
                    <TextBlock
                        x:Name="VersionText"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="v2.8.6" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
