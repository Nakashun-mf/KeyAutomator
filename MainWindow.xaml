<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="KeyAutomator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:KeyAutomator.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KeyAutomator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="KeyAutomator"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True" />
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
            <Style x:Key="InlineLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CompactActionItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="SlimButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="KeyAutomator"
            Subtitle="キー入力マクロ">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1" Padding="20,8,20,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左: マクロ一覧 -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="マクロ一覧" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="選ぶと右で編集 / ドラッグで並べ替え" />
                    </StackPanel>

                    <ListView
                        x:Name="MacroList"
                        Grid.Row="1"
                        AllowDrop="True"
                        AutomationProperties.Name="マクロ一覧"
                        CanDragItems="True"
                        CanReorderItems="True"
                        DragItemsCompleted="MacroList_DragItemsCompleted"
                        ItemsSource="{Binding Macros}"
                        KeyDown="MacroList_KeyDown"
                        SelectedItem="{Binding SelectedMacro, Mode=TwoWay}"
                        SelectionMode="Single"
                        ToolTipService.ToolTip="ドラッグで並べ替えできます">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Text="{Binding Id}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding DelayLabel}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{Binding ActionCountLabel}" />
                                        <TextBlock
                                            FontSize="12"
                                            FontFamily="Consolas"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding AliasLabel}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Button
                            AccessKey="N"
                            AutomationProperties.Name="新規作成"
                            Click="NewButton_Click"
                            Content="新規"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            AutomationProperties.Name="複製"
                            Click="CloneButton_Click"
                            Content="複製"
                            IsEnabled="{Binding HasSelection}" />
                        <Button
                            AutomationProperties.Name="削除"
                            Click="DeleteButton_Click"
                            Content="削除"
                            IsEnabled="{Binding HasSelection}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右: 編集 -->
            <Border
                Grid.Column="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <!-- 未選択時 -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisInvert}}">
                        <FontIcon
                            FontSize="40"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8A5;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="マクロを選んでください" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="左の一覧から選ぶか、「新規」で作成します" />
                    </StackPanel>

                    <!-- 編集本体 -->
                    <ContentControl
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- タイトル + 基本情報（1枠） -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    VerticalAlignment="Top"
                                    Margin="0,8,0,0"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="編集" />

                                <Border
                                    Grid.Column="1"
                                    Padding="12,10"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- 1行目: ID / 名前 -->
                                        <TextBlock Style="{StaticResource InlineLabelStyle}" Text="ID" />
                                        <NumberBox
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="マクロID"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{Binding EditId, Mode=TwoWay}" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{StaticResource InlineLabelStyle}"
                                            Text="名前" />
                                        <TextBox
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="マクロ名"
                                            PlaceholderText="表示名"
                                            Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!-- 2行目: 待ち / 引数名 -->
                                        <TextBlock
                                            Grid.Row="1"
                                            Style="{StaticResource InlineLabelStyle}"
                                            Text="待ち" />
                                        <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="起動前ウェイト秒"
                                                Minimum="0"
                                                SmallChange="0.5"
                                                SpinButtonPlacementMode="Compact"
                                                ToolTipService.ToolTip="開始までの秒数。このあいだに入力先ウィンドウへ切り替えてください"
                                                Value="{Binding EditDelaySec, Mode=TwoWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource InlineLabelStyle}"
                                                Margin="0"
                                                Text="秒" />
                                        </Grid>

                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Style="{StaticResource InlineLabelStyle}"
                                            Text="引数名"
                                            ToolTipService.ToolTip="CLI用。英数字と _ のみ。例: login_ok" />
                                        <TextBox
                                            Grid.Row="1"
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="引数名エイリアス"
                                            FontFamily="Consolas"
                                            PlaceholderText="login_ok（英数字と _ ）"
                                            Text="{Binding EditAlias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTipService.ToolTip="KeyAutomator.exe -alias login_ok や -login_ok で実行" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 実行手順: ツールバー -->
                            <Grid Grid.Row="1">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource SectionTitleStyle}"
                                        VerticalAlignment="Center"
                                        Text="実行手順" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ActionSummary}" />
                                </StackPanel>
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button
                                        AutomationProperties.Name="テキスト追加"
                                        Click="AddText_Click"
                                        Content="テキスト"
                                        Style="{StaticResource SlimButtonStyle}" />
                                    <Button
                                        AutomationProperties.Name="特殊キー追加"
                                        Click="AddKey_Click"
                                        Content="キー"
                                        Style="{StaticResource SlimButtonStyle}" />
                                    <Button
                                        AutomationProperties.Name="ショートカット追加"
                                        Click="AddHotkey_Click"
                                        Content="ショートカット"
                                        Style="{StaticResource SlimButtonStyle}" />
                                    <Button
                                        AutomationProperties.Name="マウスクリック追加"
                                        Click="AddMouse_Click"
                                        Content="マウス"
                                        Style="{StaticResource SlimButtonStyle}" />
                                    <Button
                                        AutomationProperties.Name="ウェイト追加"
                                        Click="AddWait_Click"
                                        Content="待つ"
                                        Style="{StaticResource SlimButtonStyle}" />
                                    <Border
                                        Width="1"
                                        Margin="4,2"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Button
                                        AutomationProperties.Name="上へ"
                                        Click="MoveUp_Click"
                                        Content="↑"
                                        Style="{StaticResource SlimButtonStyle}"
                                        ToolTipService.ToolTip="上へ" />
                                    <Button
                                        AutomationProperties.Name="下へ"
                                        Click="MoveDown_Click"
                                        Content="↓"
                                        Style="{StaticResource SlimButtonStyle}"
                                        ToolTipService.ToolTip="下へ" />
                                    <Button
                                        AutomationProperties.Name="アクション削除"
                                        Click="RemoveAction_Click"
                                        Content="削除"
                                        Style="{StaticResource SlimButtonStyle}" />
                                </StackPanel>
                            </Grid>

                            <!-- 固定カラムヘッダー -->
                            <Border
                                Grid.Row="2"
                                Padding="8,6"
                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="8,8,0,0">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="148" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="#" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="種類" />
                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="内容" />
                                </Grid>
                            </Border>

                            <!-- スクロールする手順一覧（ヘッダーは上で固定） -->
                            <Border
                                Grid.Row="3"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,8,8">
                                <ListView
                                    x:Name="ActionList"
                                    Padding="6,4"
                                    AllowDrop="True"
                                    AutomationProperties.Name="アクション一覧"
                                    CanDragItems="True"
                                    CanReorderItems="True"
                                    DragItemsCompleted="ActionList_DragItemsCompleted"
                                    ItemContainerStyle="{StaticResource CompactActionItemStyle}"
                                    ItemsSource="{Binding Actions}"
                                    KeyDown="ActionList_KeyDown"
                                    SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                    SelectionMode="Single"
                                    ToolTipService.ToolTip="ドラッグで手順を並べ替えできます">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                MinHeight="47"
                                                Padding="0"
                                                ColumnSpacing="0"
                                                ToolTipService.ToolTip="{Binding Hint}">
                                                <Border
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="6"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />

                                                <Grid Padding="8,4,8,4" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="148" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border
                                                        Width="28"
                                                        Height="28"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{Binding Step}" />
                                                    </Border>

                                                    <ComboBox
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="アクション種別"
                                                        DisplayMemberPath="Label"
                                                        ItemsSource="{Binding TypeOptions}"
                                                        SelectedItem="{Binding SelectedTypeOption, Mode=TwoWay}" />

                                                    <!-- 特殊キー -->
                                                    <ComboBox
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="特殊キー選択"
                                                        DisplayMemberPath="Label"
                                                        IsTextSearchEnabled="True"
                                                        ItemsSource="{Binding SpecialKeyOptions}"
                                                        MaxDropDownHeight="420"
                                                        SelectedItem="{Binding SelectedSpecialKey, Mode=TwoWay}"
                                                        Visibility="{Binding IsKeyType, Converter={StaticResource BoolToVis}}" />

                                                    <!-- マウスクリック -->
                                                    <ComboBox
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="マウス操作選択"
                                                        DisplayMemberPath="Label"
                                                        ItemsSource="{Binding MouseActionOptions}"
                                                        SelectedItem="{Binding SelectedMouseAction, Mode=TwoWay}"
                                                        Visibility="{Binding IsMouseType, Converter={StaticResource BoolToVis}}" />

                                                    <!-- ショートカット: 同時押しキーを複数追加 -->
                                                    <ScrollViewer
                                                        Grid.Column="2"
                                                        HorizontalScrollBarVisibility="Auto"
                                                        HorizontalScrollMode="Enabled"
                                                        VerticalScrollBarVisibility="Disabled"
                                                        VerticalScrollMode="Disabled"
                                                        Visibility="{Binding IsHotkeyType, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <ItemsControl ItemsSource="{Binding HotkeyParts}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                            <ComboBox
                                                                                MinWidth="100"
                                                                                VerticalAlignment="Center"
                                                                                AutomationProperties.Name="同時押しキー"
                                                                                DisplayMemberPath="Label"
                                                                                IsTextSearchEnabled="True"
                                                                                ItemsSource="{Binding KeyOptions}"
                                                                                MaxDropDownHeight="360"
                                                                                SelectedItem="{Binding SelectedOption, Mode=TwoWay}" />
                                                                            <Button
                                                                                Padding="6,2"
                                                                                VerticalAlignment="Center"
                                                                                AutomationProperties.Name="キーを外す"
                                                                                Command="{Binding RemoveCommand}"
                                                                                Content="×"
                                                                                FontSize="12"
                                                                                ToolTipService.ToolTip="このキーを外す" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button
                                                                Padding="8,2"
                                                                VerticalAlignment="Center"
                                                                AutomationProperties.Name="キーを追加"
                                                                Command="{Binding AddHotkeyPartCommand}"
                                                                Content="＋"
                                                                FontSize="12"
                                                                ToolTipService.ToolTip="同時押しするキーを追加" />
                                                        </StackPanel>
                                                    </ScrollViewer>

                                                    <!-- テキスト / 待機 -->
                                                    <TextBox
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="アクション設定値"
                                                        PlaceholderText="{Binding Placeholder}"
                                                        Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Visibility="{Binding IsFreeTextType, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>

                            <!-- 保存バー -->
                            <StackPanel
                                Grid.Row="4"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    AccessKey="S"
                                    AutomationProperties.Name="保存"
                                    Click="SaveButton_Click"
                                    Content="保存"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    AutomationProperties.Name="キャンセル"
                                    Click="CancelButton_Click"
                                    Content="破棄"
                                    Style="{StaticResource SlimButtonStyle}" />
                                <Button
                                    x:Name="TestButton"
                                    AutomationProperties.Name="テスト実行"
                                    Click="TestButton_Click"
                                    Content="テスト実行"
                                    Style="{StaticResource SlimButtonStyle}"
                                    ToolTipService.ToolTip="待ち時間のあいだに入力先ウィンドウへ切り替えてください" />
                            </StackPanel>
                        </Grid>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="20,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding StatusMessage}" />

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="削除前に確認" />
                    <ToggleSwitch
                        VerticalAlignment="Center"
                        AutomationProperties.Name="削除前に確認"
                        IsOn="{Binding ConfirmBeforeDelete, Mode=TwoWay}"
                        OffContent="OFF"
                        OnContent="ON"
                        ToolTipService.ToolTip="オフにすると、マクロ／手順の削除確認を出さずに削除します" />
                </StackPanel>

                <TextBlock
                    x:Name="VersionText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="v2.4.0" />
            </Grid>
        </Border>
    </Grid>
</Window>
