<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="KeyAutomator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:KeyAutomator.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KeyAutomator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="KeyAutomator"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True" />
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
            <Style x:Key="InlineLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CompactActionItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="SlimButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="KeyAutomator"
            Subtitle="キー入力マクロ">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1" Padding="20,8,20,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左: マクロ一覧 -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="マクロ一覧" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="選ぶと右で編集できます" />
                    </StackPanel>

                    <ListView
                        x:Name="MacroList"
                        Grid.Row="1"
                        AutomationProperties.Name="マクロ一覧"
                        ItemsSource="{Binding Macros}"
                        SelectedItem="{Binding SelectedMacro, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        MinWidth="36"
                                        Padding="8,4"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Text="{Binding Id}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding DelayLabel}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{Binding ActionCountLabel}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Button
                            AccessKey="N"
                            AutomationProperties.Name="新規作成"
                            Click="NewButton_Click"
                            Content="新規"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            AutomationProperties.Name="複製"
                            Click="CloneButton_Click"
                            Content="複製"
                            IsEnabled="{Binding HasSelection}" />
                        <Button
                            AutomationProperties.Name="削除"
                            Click="DeleteButton_Click"
                            Content="削除"
                            IsEnabled="{Binding HasSelection}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右: 編集 -->
            <Border
                Grid.Column="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <!-- 未選択時 -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisInvert}}">
                        <FontIcon
                            FontSize="40"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE8A5;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="マクロを選んでください" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="左の一覧から選ぶか、「新規」で作成します" />
                    </StackPanel>

                    <!-- 編集本体 -->
                    <ContentControl
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- タイトル + 基本情報（1行コンパクト） -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="編集" />

                                <Border
                                    Grid.Column="1"
                                    Padding="10,6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Style="{StaticResource InlineLabelStyle}" Text="ID" />
                                        <NumberBox
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="マクロID"
                                            Minimum="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{Binding EditId, Mode=TwoWay}" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{StaticResource InlineLabelStyle}"
                                            Text="名前" />
                                        <TextBox
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="マクロ名"
                                            PlaceholderText="表示名"
                                            Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock
                                            Grid.Column="4"
                                            Style="{StaticResource InlineLabelStyle}"
                                            Text="待ち" />
                                        <NumberBox
                                            Grid.Column="5"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="起動前ウェイト秒"
                                            Minimum="0"
                                            SmallChange="0.5"
                                            SpinButtonPlacementMode="Compact"
                                            ToolTipService.ToolTip="開始までの秒数。このあいだに入力先ウィンドウへ切り替えてください"
                                            Value="{Binding EditDelaySec, Mode=TwoWay}" />
                                        <TextBlock
                                            Grid.Column="6"
                                            Style="{StaticResource InlineLabelStyle}"
                                            Text="秒" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 実行手順: ツールバー -->
                            <Grid Grid.Row="1">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource SectionTitleStyle}"
                                        VerticalAlignment="Center"
                                        Text="実行手順" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ActionSummary}" />
                                </StackPanel>
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button
                                        AutomationProperties.Name="テキスト追加"
                                        Click="AddText_Click"
                                        Content="テキスト"
                                        Style="{StaticResource SlimButtonStyle}" />
                                    <Button
                                        AutomationProperties.Name="特殊キー追加"
                                        Click="AddKey_Click"
                                        Content="キー"
                                        Style="{StaticResource SlimButtonStyle}" />
                                    <Button
                                        AutomationProperties.Name="ショートカット追加"
                                        Click="AddHotkey_Click"
                                        Content="ショートカット"
                                        Style="{StaticResource SlimButtonStyle}" />
                                    <Button
                                        AutomationProperties.Name="ウェイト追加"
                                        Click="AddWait_Click"
                                        Content="待つ"
                                        Style="{StaticResource SlimButtonStyle}" />
                                    <Border
                                        Width="1"
                                        Margin="4,2"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Button
                                        AutomationProperties.Name="上へ"
                                        Click="MoveUp_Click"
                                        Content="↑"
                                        Style="{StaticResource SlimButtonStyle}"
                                        ToolTipService.ToolTip="上へ" />
                                    <Button
                                        AutomationProperties.Name="下へ"
                                        Click="MoveDown_Click"
                                        Content="↓"
                                        Style="{StaticResource SlimButtonStyle}"
                                        ToolTipService.ToolTip="下へ" />
                                    <Button
                                        AutomationProperties.Name="アクション削除"
                                        Click="RemoveAction_Click"
                                        Content="削除"
                                        Style="{StaticResource SlimButtonStyle}" />
                                </StackPanel>
                            </Grid>

                            <!-- 固定カラムヘッダー -->
                            <Border
                                Grid.Row="2"
                                Padding="8,6"
                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="8,8,0,0">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="148" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="#" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="種類" />
                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="内容" />
                                </Grid>
                            </Border>

                            <!-- スクロールする手順一覧（ヘッダーは上で固定） -->
                            <Border
                                Grid.Row="3"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,8,8">
                                <ListView
                                    Padding="6,4"
                                    AutomationProperties.Name="アクション一覧"
                                    ItemContainerStyle="{StaticResource CompactActionItemStyle}"
                                    ItemsSource="{Binding Actions}"
                                    SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Height="34"
                                                Padding="2,0"
                                                ColumnSpacing="8"
                                                ToolTipService.ToolTip="{Binding Hint}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="148" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Step}" />

                                                <ComboBox
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="アクション種別"
                                                    DisplayMemberPath="Label"
                                                    ItemsSource="{Binding TypeOptions}"
                                                    SelectedItem="{Binding SelectedTypeOption, Mode=TwoWay}" />

                                                <TextBox
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="アクション設定値"
                                                    PlaceholderText="{Binding Placeholder}"
                                                    Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>

                            <!-- 保存バー -->
                            <StackPanel
                                Grid.Row="4"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    AccessKey="S"
                                    AutomationProperties.Name="保存"
                                    Click="SaveButton_Click"
                                    Content="保存"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    AutomationProperties.Name="キャンセル"
                                    Click="CancelButton_Click"
                                    Content="破棄"
                                    Style="{StaticResource SlimButtonStyle}" />
                                <Button
                                    x:Name="TestButton"
                                    AutomationProperties.Name="テスト実行"
                                    Click="TestButton_Click"
                                    Content="テスト実行"
                                    Style="{StaticResource SlimButtonStyle}"
                                    ToolTipService.ToolTip="待ち時間のあいだに入力先ウィンドウへ切り替えてください" />
                            </StackPanel>
                        </Grid>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="20,10"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding StatusMessage}" />
                <TextBlock
                    x:Name="VersionText"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="v2.0.3" />
            </Grid>
        </Border>

        <ContentDialog
            x:Name="HotkeyDialog"
            Title="ショートカットを記録"
            CloseButtonText="キャンセル"
            DefaultButton="Primary"
            PrimaryButtonClick="HotkeyDialog_PrimaryButtonClick"
            PrimaryButtonText="追加">
            <StackPanel Spacing="12">
                <TextBlock
                    Text="キーボードで組み合わせを押してください（例: Ctrl+Shift+S）"
                    TextWrapping="WrapWholeWords" />
                <Border
                    Padding="16"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8"
                    IsTabStop="True"
                    KeyDown="HotkeyCaptureArea_KeyDown">
                    <TextBlock
                        x:Name="HotkeyResultText"
                        FontFamily="Consolas"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="キーを押してください…" />
                </Border>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
